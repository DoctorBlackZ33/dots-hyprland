#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="${END4_REPO_ROOT:-$script_root}"
if ! repo_root="$(cd -- "$repo_root" 2>/dev/null && pwd -P)"; then
    printf 'end4: repository path does not exist: %s\n' "$repo_root" >&2
    exit 1
fi

user_home="${HOME:?HOME is required}"
config_root="${XDG_CONFIG_HOME:-$user_home/.config}"
data_root="${XDG_DATA_HOME:-$user_home/.local/share}"
upstream_ref="${END4_UPSTREAM_REF:-upstream/main}"

assume_yes=false
device_name=''
device_selection_set=false
dry_run=false
force_apply=false
prune=false
prompt_for_device=false
from_lazygit="${END4_FROM_LAZYGIT:-0}"

usage() {
    cat <<'EOF'
Usage: end4 <command> [options]

Unified system workflow:
  system                         Open the end-4 maintenance menu
  merge [--yes]                  Fetch upstream and prepare a reviewed merge
  update [options]               Preview, confirm, and deploy committed config
  discard [--yes]                Abort merge and discard uncommitted changes
  tui                            Open LazyGit for this repository
  review                         Compare common base, fork, and upstream

System update options:
  --device NAME                  Apply General plus a named device overlay
  --general                      Apply the General configuration only
  --prune                        Explicitly remove extras in upstream-managed dirs
  --dry-run                      Show the deployment plan without changing files
  --yes                          Skip the confirmation prompt (automation only)

Other commands:
  status                         Show custom-vs-upstream Git state
  check                          Validate scripts and configuration syntax
  apply [options]                Compatibility deployment command
  bootstrap [setup options...]   Run the upstream dependency/full installer

Normal flow:
  system merge                   Review upstream changes in LazyGit
  system update                  Dry-run, choose a device, then deploy
  system discard                 Abort a merge or discard active uncommitted work
EOF
}

die() {
    printf 'end4: %s\n' "$*" >&2
    exit 1
}

git_at_repo() {
    git -C "$repo_root" "$@"
}

require_repo() {
    git_at_repo rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a Git worktree: $repo_root"
}

require_clean_worktree() {
    local status_output
    status_output="$(git_at_repo status --porcelain)"
    if [[ -n "$status_output" ]]; then
        printf '%s\n' "$status_output"
        die 'working tree is not clean; commit or intentionally discard these changes first'
    fi
}

require_no_merge() {
    if git_at_repo rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        die 'a merge is already in progress; resolve it or run system discard'
    fi
}

require_upstream_ref() {
    git_at_repo show-ref --verify --quiet "refs/remotes/$upstream_ref" || \
        die "missing $upstream_ref; run system merge to fetch upstream"
}

has_interactive_tty() {
    [[ -t 0 && -t 1 ]]
}

has_whiptail_tty() {
    has_interactive_tty && [[ "${TERM:-}" != dumb ]] && command -v whiptail >/dev/null 2>&1
}

confirm_action() {
    local prompt="$1"
    [[ "$assume_yes" == true ]] && return 0

    if has_whiptail_tty; then
        whiptail --title 'end-4 system' --yesno "$prompt" 12 82
        return $?
    fi

    if ! has_interactive_tty; then
        die 'confirmation requires an interactive terminal; use --yes only for intentional automation'
    fi

    local response
    read -r -p "$prompt [y/N] " response < /dev/tty
    [[ "$response" =~ ^[Yy]([Ee][Ss])?$ ]]
}

typed_discard_confirmation() {
    [[ "$assume_yes" == true ]] && return 0

    local response
    if has_whiptail_tty; then
        response="$(whiptail --title 'Discard local Git state' \
            --inputbox 'This removes the active merge, uncommitted tracked changes, and untracked non-ignored files.\n\nType DISCARD to continue.' \
            14 82 '' 3>&1 1>&2 2>&3)" || return 1
    else
        if ! has_interactive_tty; then
            die 'discard requires typing DISCARD in an interactive terminal; use --yes only for intentional automation'
        fi
        printf '\nThis removes the active merge, uncommitted tracked changes, and untracked non-ignored files.\n'
        printf 'Type DISCARD to continue: '
        read -r response < /dev/tty
    fi

    [[ "$response" == DISCARD ]]
}

show_paged_report() {
    local report_file="$1"
    if has_interactive_tty && command -v less >/dev/null 2>&1; then
        less -R -- "$report_file"
    else
        cat -- "$report_file"
    fi
}

print_git_status() {
    printf '%s\n' "Repository: $repo_root"
    printf 'Branch:     %s\n' "$(git_at_repo branch --show-current)"
    printf 'HEAD:       %s\n' "$(git_at_repo log -1 --format='%h %s')"
    printf 'Upstream:   %s\n' "$(git_at_repo log -1 --format='%h %s' "$upstream_ref" 2>/dev/null || printf 'unavailable')"
    printf '\nWorking tree:\n'
    git_at_repo status --short --branch

    if git_at_repo show-ref --verify --quiet "refs/remotes/$upstream_ref"; then
        printf '\nCustom commits not in upstream:\n'
        git_at_repo log --oneline "$upstream_ref..HEAD" || true
        printf '\nFiles changed by this fork relative to upstream:\n'
        git_at_repo diff --stat "$upstream_ref...HEAD" || true
        printf '\nIncoming commits currently known locally:\n'
        git_at_repo log --oneline "HEAD..$upstream_ref" || true
    else
        printf '\nNo local upstream tracking ref. Run: system merge\n'
    fi

    printf '\nLive deployment differences are available with:\n'
    printf '  system update --dry-run\n'
}

print_merge_state() {
    if git_at_repo rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        printf '\nMerge is still in progress. Unresolved files:\n'
        local unresolved
        unresolved="$(git_at_repo diff --name-only --diff-filter=U || true)"
        if [[ -n "$unresolved" ]]; then
            printf '%s\n' "$unresolved"
            printf '\nUse LazyGit to choose ours, theirs, both, or edit each conflict.\n'
        else
            printf '%s\n' '(none; stage resolved files, then commit the merge when ready)'
        fi
        git_at_repo status --short
    else
        printf '\nNo merge is in progress. The prepared changes remain uncommitted until you commit them.\n'
        git_at_repo status --short
    fi
}

build_review_entries() {
    local base_ref="$1"
    local upstream_ref_name="$2"
    local output_file="$3"
    local path upstream_changed custom_changed marker

    {
        git_at_repo diff --name-only "$base_ref" "$upstream_ref_name" || true
        git_at_repo diff --name-only "$base_ref" HEAD || true
    } | sort -u | while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        upstream_changed=false
        custom_changed=false
        if ! git_at_repo diff --quiet "$base_ref" "$upstream_ref_name" -- "$path"; then
            upstream_changed=true
        fi
        if ! git_at_repo diff --quiet "$base_ref" HEAD -- "$path"; then
            custom_changed=true
        fi
        if [[ "$upstream_changed" == true && "$custom_changed" == true ]]; then
            marker=UC
        elif [[ "$upstream_changed" == true ]]; then
            marker=U
        else
            marker=C
        fi
        printf '%s\t%s\n' "$marker" "$path"
    done > "$output_file"
}

materialize_review_file() {
    local ref="$1"
    local path="$2"
    local destination="$3"
    local object_type

    mkdir -p "$(dirname -- "$destination")"
    object_type="$(git_at_repo cat-file -t "$ref:$path" 2>/dev/null || true)"
    if [[ "$object_type" == blob ]]; then
        git_at_repo show "$ref:$path" > "$destination"
    else
        printf '[%s: file is absent in this revision]\n' "$ref" > "$destination"
    fi
}

review_one_file() {
    local base_ref="$1"
    local path="$2"
    local temporary_root base_file fork_file upstream_file
    temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/end4-review.XXXXXX")"
    base_file="$temporary_root/BASE-common-ancestor/$path"
    fork_file="$temporary_root/FORK-custom-main/$path"
    upstream_file="$temporary_root/UPSTREAM-end4-main/$path"

    materialize_review_file "$base_ref" "$path" "$base_file"
    materialize_review_file HEAD "$path" "$fork_file"
    materialize_review_file "$upstream_ref" "$path" "$upstream_file"

    printf '\n3-way review: %s\n' "$path"
    printf '  left   = BASE common ancestor\n'
    printf '  middle = FORK custom main (ours)\n'
    printf '  right  = UPSTREAM end-4 main (theirs)\n'
    if command -v nvim >/dev/null 2>&1; then
        nvim -d "$base_file" "$fork_file" "$upstream_file" || true
    elif command -v vimdiff >/dev/null 2>&1; then
        vimdiff "$base_file" "$fork_file" "$upstream_file" || true
    fi
    rm -rf -- "$temporary_root"
}

show_comparison_fallback() {
    local base_ref="$1"
    local report_file
    report_file="$(mktemp "${TMPDIR:-/tmp}/end4-review-report.XXXXXX")"
    {
        printf 'end-4 comparison fallback\n\n'
        printf "BASE -> FORK (this fork's changes):\n"
        git_at_repo diff --color=always "$base_ref" HEAD
        printf "\nBASE -> UPSTREAM (end-4's changes):\n"
        git_at_repo diff --color=always "$base_ref" "$upstream_ref"
    } > "$report_file"
    show_paged_report "$report_file" || true
    rm -f -- "$report_file"
}

review_changes() {
    local base_ref entries_file path_count upstream_count custom_count
    base_ref="$(git_at_repo merge-base HEAD "$upstream_ref")" || die 'could not find a common base with upstream/main'
    entries_file="$(mktemp "${TMPDIR:-/tmp}/end4-review-files.XXXXXX")"
    build_review_entries "$base_ref" "$upstream_ref" "$entries_file"

    upstream_count="$(git_at_repo rev-list --count "$base_ref..$upstream_ref")"
    custom_count="$(git_at_repo rev-list --count "$base_ref..HEAD")"
    path_count="$(wc -l < "$entries_file")"

    printf '\nend-4 three-way comparison\n'
    printf '  BASE:     %s\n' "$(git_at_repo log -1 --format='%h %s' "$base_ref")"
    printf '  FORK:     %s\n' "$(git_at_repo log -1 --format='%h %s' HEAD)"
    printf '  UPSTREAM: %s\n' "$(git_at_repo log -1 --format='%h %s' "$upstream_ref")"
    printf '  Commits since BASE: %d fork, %d upstream\n' "$custom_count" "$upstream_count"
    printf '  Files changed by either side: %d\n' "$path_count"
    printf '\nFork changes (BASE -> FORK):\n'
    git_at_repo diff --stat "$base_ref" HEAD
    printf '\nUpstream changes (BASE -> UPSTREAM):\n'
    git_at_repo diff --stat "$base_ref" "$upstream_ref"
    printf '\nFile ownership markers: U = upstream changed, C = fork changed, UC = both changed.\n'
    sed 's/\t/  /' "$entries_file"

    if [[ "$path_count" -eq 0 ]]; then
        rm -f -- "$entries_file"
        printf '\nNo file changes need review.\n'
        return 0
    fi

    if has_interactive_tty && command -v fzf >/dev/null 2>&1 && \
        { command -v nvim >/dev/null 2>&1 || command -v vimdiff >/dev/null 2>&1; }; then
        local selected_files
        printf '\nSelect one or more files to open in a 3-pane diff.\n'
        selected_files="$(fzf --multi --height=80% --layout=reverse --border \
            --prompt='review files > ' \
            --header='UC = both sides changed; U = upstream only; C = fork only. Enter opens selected files.' \
            < "$entries_file")" || true
        if [[ -n "$selected_files" ]]; then
            while IFS=$'\t' read -r _ path; do
                [[ -n "$path" ]] || continue
                review_one_file "$base_ref" "$path"
            done <<< "$selected_files"
        fi
    elif has_interactive_tty; then
        printf '\nA 3-pane editor review needs fzf and nvim/vimdiff; showing a colored fallback instead.\n'
        show_comparison_fallback "$base_ref"
    else
        printf '\nInteractive review is unavailable on this terminal; use system review in a TTY.\n'
    fi
    rm -f -- "$entries_file"
}

run_lazygit() {
    local repo_lazygit_config="$repo_root/local/.config/lazygit/config.yml"
    if [[ -f "$repo_lazygit_config" ]]; then
        lazygit --path "$repo_root" --use-config-file "$repo_lazygit_config" "$@"
    else
        lazygit --path "$repo_root" "$@"
    fi
}

ensure_repo_lazygit_config() {
    local source_config="$repo_root/local/.config/lazygit/config.yml"
    local repo_config="$repo_root/.git/lazygit.yml"
    [[ -f "$source_config" ]] || return 0
    [[ -e "$repo_config" || -L "$repo_config" ]] && return 0
    ln -s ../local/.config/lazygit/config.yml "$repo_config" || \
        printf 'end4: warning: could not install the repository LazyGit config\n' >&2
}

launch_lazygit_review() {
    if [[ "$from_lazygit" == 1 ]]; then
        return 0
    fi
    if ! has_interactive_tty; then
        printf 'LazyGit review was not launched because this is not an interactive terminal.\n'
        return 0
    fi
    if ! command -v lazygit >/dev/null 2>&1; then
        printf 'LazyGit is not installed; inspect the merge with git status/git diff, or install LazyGit.\n' >&2
        return 0
    fi
    printf '\nOpening LazyGit for merge review. Exit LazyGit when you are done resolving or inspecting.\n'
    run_lazygit || printf 'end4: warning: LazyGit exited with a non-zero status\n' >&2
}

merge_upstream() {
    require_clean_worktree
    require_no_merge

    printf 'Fetching upstream...\n'
    git_at_repo fetch --prune upstream || die 'unable to fetch upstream'
    require_upstream_ref

    local incoming_count
    incoming_count="$(git_at_repo rev-list --count "HEAD..$upstream_ref")"
    if [[ "$incoming_count" -eq 0 ]]; then
        printf 'Already synchronized with upstream/main. No merge required.\n'
        return 0
    fi

    review_changes

    if ! confirm_action 'Start a non-committing merge of upstream/main into this fork after this review?'; then
        printf 'Merge cancelled.\n'
        return 0
    fi

    printf '\nStarting a non-committing merge.\n'
    local merge_status=0
    if git_at_repo merge --no-ff --no-commit "$upstream_ref"; then
        printf '\nMerge prepared and left uncommitted.\n'
    else
        merge_status=$?
        printf '\nMerge stopped with conflicts.\n' >&2
    fi

    launch_lazygit_review
    print_merge_state

    if [[ "$merge_status" -ne 0 ]]; then
        printf '\nResolve conflicts in LazyGit, stage the resolved files, and commit when ready.\n' >&2
        printf 'To abandon the merge safely: system discard\n' >&2
        return "$merge_status"
    fi

    printf '\nReview with LazyGit or git diff --cached, then run system check and commit the merge.\n'
}

review_upstream() {
    require_clean_worktree
    require_no_merge

    printf 'Fetching upstream...\n'
    git_at_repo fetch --prune upstream || die 'unable to fetch upstream'
    require_upstream_ref

    local incoming_count
    incoming_count="$(git_at_repo rev-list --count "HEAD..$upstream_ref")"
    if [[ "$incoming_count" -eq 0 ]]; then
        printf 'Already synchronized with upstream/main. No comparison required.\n'
        return 0
    fi
    review_changes
}

device_is_known() {
    local candidate="$1"
    local known
    [[ -n "$candidate" && "$candidate" != */* && "$candidate" != . && "$candidate" != .. ]] || return 1
    [[ -d "$repo_root/devices/$candidate/.config" ]] || return 1
    while IFS= read -r known; do
        [[ "$known" == "$candidate" ]] && return 0
    done < <(find "$repo_root/devices" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
    return 1
}

normalize_device() {
    local requested="$1"
    case "$requested" in
        ''|general|General|none|None)
            device_name=''
            device_selection_set=true
            ;;
        *)
            device_is_known "$requested" || die "unknown device overlay: $requested"
            device_name="$requested"
            device_selection_set=true
            ;;
    esac
}

choose_device() {
    [[ "$device_selection_set" == true ]] && return 0

    if ! has_interactive_tty; then
        die 'system update needs a device choice; use --general or --device NAME when no menu is available'
    fi

    local selected=''
    if has_whiptail_tty; then
        local -a menu_args=(general 'General only')
        local known
        while IFS= read -r known; do
            menu_args+=("$known" "General plus $known overlay")
        done < <(find "$repo_root/devices" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
        selected="$(whiptail --title 'Choose deployment target' \
            --menu 'Select the general configuration or a device overlay:' \
            18 88 8 "${menu_args[@]}" 3>&1 1>&2 2>&3)" || die 'device selection cancelled'
    else
        printf '\nDeployment targets:\n'
        printf '  1) General only\n'
        local -a names=()
        local known index=2
        while IFS= read -r known; do
            names+=("$known")
            printf '  %d) General plus %s\n' "$index" "$known"
            index=$((index + 1))
        done < <(find "$repo_root/devices" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
        local choice
        read -r -p 'Choose a target [1]: ' choice < /dev/tty
        choice="${choice:-1}"
        if [[ "$choice" == 1 ]]; then
            selected=general
        elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 2 && choice < index )); then
            selected="${names[choice-2]}"
        else
            die 'invalid device selection'
        fi
    fi

    normalize_device "$selected"
    if [[ -n "$device_name" ]]; then
        printf 'Selected deployment target: General + %s\n' "$device_name"
    else
        printf 'Selected deployment target: General only\n'
    fi
}

upstream_sync_mode() {
    if [[ "$prune" == true ]]; then
        printf 'delete'
    else
        printf 'keep'
    fi
}

preview_dir() {
    local mode="$1"
    local source_dir="$2"
    local target_dir="$3"
    shift 3
    [[ -d "$source_dir" ]] || { printf '\nwarning: source directory is missing: %s\n' "$source_dir" >&2; return 0; }
    if [[ -e "$target_dir" && ! -d "$target_dir" ]]; then
        printf '\nwarning: target exists but is not a directory: %s\n' "$target_dir" >&2
        return 0
    fi

    local comparison_target="$target_dir"
    local temporary_target=''
    if [[ ! -d "$target_dir" ]]; then
        temporary_target="$(mktemp -d "${TMPDIR:-/tmp}/end4-preview.XXXXXX")"
        comparison_target="$temporary_target"
        printf '\ncreate directory %s\n' "$target_dir"
    fi

    local rsync_args=(-ani --checksum --no-times --human-readable)
    [[ "$mode" == delete ]] && rsync_args+=(--delete)
    printf '\n%s -> %s (%s upstream policy)\n' "$source_dir" "$target_dir" "$mode"
    rsync "${rsync_args[@]}" "$@" "$source_dir/" "$comparison_target/" || true
    if [[ -n "$temporary_target" ]]; then
        rmdir -- "$temporary_target"
    fi
}

preview_file() {
    local source_file="$1"
    local target_file="$2"
    [[ -f "$source_file" ]] || { printf '\nwarning: source file is missing: %s\n' "$source_file" >&2; return 0; }
    if [[ ! -e "$target_file" ]]; then
        printf '\ncreate %s\n' "$target_file"
    elif [[ -d "$target_file" ]]; then
        printf '\nwarning: target exists as a directory: %s\n' "$target_file" >&2
    elif ! cmp -s "$source_file" "$target_file"; then
        printf '\nupdate %s\n' "$target_file"
        diff -u "$target_file" "$source_file" || true
    fi
}

sync_dir() {
    local mode="$1"
    local source_dir="$2"
    local target_dir="$3"
    shift 3
    [[ -d "$source_dir" ]] || die "source directory is missing: $source_dir"
    mkdir -p "$target_dir"
    local rsync_args=(-a --checksum --no-times)
    [[ "$mode" == delete ]] && rsync_args+=(--delete)
    rsync "${rsync_args[@]}" "$@" "$source_dir/" "$target_dir/"
}

sync_file() {
    local source_file="$1"
    local target_file="$2"
    [[ -f "$source_file" ]] || die "source file is missing: $source_file"
    mkdir -p "$(dirname "$target_file")"
    cp -p "$source_file" "$target_file"
}

for_each_upstream_misc() {
    local source_entry source_name
    shopt -s nullglob
    for source_entry in "$repo_root/dots/.config"/*; do
        source_name="$(basename "$source_entry")"
        case "$source_name" in
            quickshell|fish|hypr|fontconfig) continue ;;
        esac
        "$1" "$source_entry" "$config_root/$source_name"
    done
    shopt -u nullglob
}

preview_entry() {
    local source_entry="$1"
    local target_entry="$2"
    if [[ -d "$source_entry" ]]; then
        preview_dir "$(upstream_sync_mode)" "$source_entry" "$target_entry"
    else
        preview_file "$source_entry" "$target_entry"
    fi
}

sync_entry() {
    local source_entry="$1"
    local target_entry="$2"
    if [[ -d "$source_entry" ]]; then
        sync_dir "$(upstream_sync_mode)" "$source_entry" "$target_entry"
    else
        sync_file "$source_entry" "$target_entry"
    fi
}

preview_upstream_files() {
    for_each_upstream_misc preview_entry
    preview_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/quickshell" "$config_root/quickshell"
    preview_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/fish" "$config_root/fish" --exclude=conf.d
    preview_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/fontconfig" "$config_root/fontconfig"
    preview_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/hypr/hyprland" "$config_root/hypr/hyprland"
    preview_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/hypr/custom" "$config_root/hypr/custom"
    preview_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/kitty" "$config_root/kitty"
    preview_file "$repo_root/dots/.config/hypr/hyprland.lua" "$config_root/hypr/hyprland.lua"
    preview_file "$repo_root/dots/.config/hypr/hyprlock.conf" "$config_root/hypr/hyprlock.conf"
    preview_file "$repo_root/dots/.config/hypr/hypridle.conf" "$config_root/hypr/hypridle.conf"
    if [[ -d "$repo_root/dots/.local/share/konsole" ]]; then
        preview_dir keep "$repo_root/dots/.local/share/konsole" "$data_root/konsole"
    fi
    if [[ -f "$repo_root/dots/.local/share/icons/illogical-impulse.svg" ]]; then
        preview_file "$repo_root/dots/.local/share/icons/illogical-impulse.svg" "$data_root/icons/illogical-impulse.svg"
    fi
}

preview_local_overlay() {
    if [[ -d "$repo_root/local/.config" ]]; then
        preview_dir keep "$repo_root/local/.config" "$config_root"
    fi
    if [[ -d "$repo_root/local/.local" ]]; then
        preview_dir keep "$repo_root/local/.local" "$user_home/.local"
    fi
}

preview_device_overlay() {
    local selected_device="$1"
    [[ -n "$selected_device" ]] || return 0
    local device_config="$repo_root/devices/$selected_device/.config"
    [[ -d "$device_config" ]] || die "device overlay not found: devices/$selected_device/.config"
    preview_dir keep "$device_config" "$config_root"
}

preview_deployment() {
    if [[ -n "$device_name" ]]; then
        printf '\nDeployment target: General + %s\n' "$device_name"
    else
        printf '\nDeployment target: General only\n'
    fi
    if [[ "$prune" == true ]]; then
        printf 'Upstream directory policy: prune extras (explicit)\n'
    else
        printf 'Upstream directory policy: preserve live extras (safe default)\n'
    fi
    preview_upstream_files
    preview_local_overlay
    preview_device_overlay "$device_name"
}

sync_upstream_files() {
    for_each_upstream_misc sync_entry
    sync_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/quickshell" "$config_root/quickshell"
    sync_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/fish" "$config_root/fish" --exclude=conf.d
    sync_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/fontconfig" "$config_root/fontconfig"
    sync_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/hypr/hyprland" "$config_root/hypr/hyprland"
    sync_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/hypr/custom" "$config_root/hypr/custom"
    sync_dir "$(upstream_sync_mode)" "$repo_root/dots/.config/kitty" "$config_root/kitty"
    sync_file "$repo_root/dots/.config/hypr/hyprland.lua" "$config_root/hypr/hyprland.lua"
    sync_file "$repo_root/dots/.config/hypr/hyprlock.conf" "$config_root/hypr/hyprlock.conf"
    sync_file "$repo_root/dots/.config/hypr/hypridle.conf" "$config_root/hypr/hypridle.conf"
    if [[ -d "$repo_root/dots/.local/share/konsole" ]]; then
        sync_dir keep "$repo_root/dots/.local/share/konsole" "$data_root/konsole"
    fi
    if [[ -f "$repo_root/dots/.local/share/icons/illogical-impulse.svg" ]]; then
        sync_file "$repo_root/dots/.local/share/icons/illogical-impulse.svg" "$data_root/icons/illogical-impulse.svg"
    fi
}

apply_local_overlay() {
    if [[ -d "$repo_root/local/.config" ]]; then
        sync_dir keep "$repo_root/local/.config" "$config_root"
    fi
    if [[ -d "$repo_root/local/.local" ]]; then
        sync_dir keep "$repo_root/local/.local" "$user_home/.local"
    fi
}

apply_device_overlay() {
    local selected_device="$1"
    [[ -n "$selected_device" ]] || return 0
    local device_config="$repo_root/devices/$selected_device/.config"
    [[ -d "$device_config" ]] || die "device overlay not found: devices/$selected_device/.config"
    sync_dir keep "$device_config" "$config_root"
}

run_deployment() {
    sync_upstream_files
    apply_local_overlay
    apply_device_overlay "$device_name"

    if command -v systemctl >/dev/null 2>&1 && [[ -f "$config_root/systemd/user/hypr-ocr-daemon.service" ]]; then
        systemctl --user daemon-reload || printf 'end4: warning: systemd daemon-reload failed\n' >&2
        systemctl --user enable hypr-ocr-daemon.service >/dev/null 2>&1 || printf 'end4: warning: could not enable OCR service\n' >&2
    fi
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null || printf 'end4: warning: hyprctl reload failed\n' >&2
    fi
}

run_shell_checks() {
    local check_failed=0
    local check_file
    while IFS= read -r -d '' check_file; do
        if ! bash -n "$check_file"; then check_failed=1; fi
    done < <(find "$repo_root/dots/.config/hypr/custom" "$repo_root/dots/.config/quickshell/ii/scripts" "$repo_root/local" "$repo_root/devices" -type f -name '*.sh' -print0 2>/dev/null)
    bash -n "$repo_root/end4" || check_failed=1
    return "$check_failed"
}

run_lua_checks() {
    command -v luac >/dev/null 2>&1 || return 0
    local check_failed=0
    local check_file
    while IFS= read -r -d '' check_file; do
        if ! luac -p "$check_file"; then check_failed=1; fi
    done < <(find "$repo_root/dots/.config/hypr" "$repo_root/local/.config/nvim" -type f -name '*.lua' -print0 2>/dev/null)
    return "$check_failed"
}

run_python_checks() {
    local check_failed=0
    local check_file
    while IFS= read -r -d '' check_file; do
        if ! python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"), filename=sys.argv[1])' "$check_file"; then
            check_failed=1
        fi
    done < <(find "$repo_root/dots/.config/hypr/custom" "$repo_root/dots/.config/quickshell/ii/scripts" "$repo_root/local" "$repo_root/devices" "$repo_root/tools" -type f -name '*.py' -print0 2>/dev/null)
    return "$check_failed"
}

run_qml_checks() {
    command -v qmllint >/dev/null 2>&1 || return 0
    local check_failed=0
    local check_file check_code
    local qml_files=(
        "$repo_root/dots/.config/quickshell/ii/modules/common/utils/ScreenshotAction.qml"
        "$repo_root/dots/.config/quickshell/ii/modules/ii/mediaControls/MediaControls.qml"
        "$repo_root/dots/.config/quickshell/ii/modules/settings/InterfaceConfig.qml"
        "$repo_root/dots/.config/quickshell/ii/modules/waffle/looks/Looks.qml"
    )
    while IFS= read -r -d '' check_file; do qml_files+=("$check_file"); done < <(
        find "$repo_root/devices" -type f -name '*.qml' -print0 2>/dev/null
    )
    for check_file in "${qml_files[@]}"; do
        [[ -f "$check_file" ]] || continue
        if qmllint -s "$check_file"; then
            continue
        else
            check_code=$?
        fi
        if [[ "$check_code" -eq 255 ]]; then
            printf 'end4: warning: qmllint could not load the project context for %s\n' "$check_file" >&2
        else
            check_failed=1
        fi
    done
    return "$check_failed"
}

run_checks() {
    local check_failed=0
    git_at_repo diff --check || check_failed=1
    git_at_repo diff --cached --check || check_failed=1
    run_shell_checks || check_failed=1
    run_lua_checks || check_failed=1
    run_python_checks || check_failed=1
    run_qml_checks || check_failed=1
    if [[ "$check_failed" -ne 0 ]]; then
        printf 'end4: one or more checks failed\n' >&2
        return 1
    fi
    printf 'end4: checks passed\n'
}

apply_configs() {
    require_clean_worktree
    require_no_merge
    [[ "$prompt_for_device" == true ]] && choose_device
    run_checks

    preview_deployment
    if [[ "$dry_run" == true ]]; then
        return 0
    fi

    local prompt='Apply these committed files to the live configuration?'
    if [[ "$prune" == true ]]; then
        prompt='Apply these files and prune extras in upstream-managed directories?'
    fi
    if [[ "$force_apply" != true ]]; then
        if ! confirm_action "$prompt"; then
            printf 'Deployment cancelled.\n'
            return 0
        fi
    fi

    run_deployment
    printf 'end4: deployment complete\n'
}

system_update() {
    prompt_for_device=true
    apply_configs
}

discard_local_state() {
    require_repo
    local status_output clean_preview
    status_output="$(git_at_repo status --short)"
    local merge_in_progress=false
    if git_at_repo rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        merge_in_progress=true
    fi

    if [[ -z "$status_output" && "$merge_in_progress" == false ]]; then
        printf 'Nothing uncommitted to discard. Committed custom history was not changed.\n'
        return 0
    fi

    printf 'Current Git state:\n'
    git_at_repo status --short --branch
    clean_preview="$(git_at_repo clean -fdn)"
    if [[ -n "$clean_preview" ]]; then
        printf '\nUntracked non-ignored files that would be removed:\n%s\n' "$clean_preview"
    else
        printf '\nNo untracked non-ignored files would be removed.\n'
    fi
    printf '\nCommitted history will be preserved.\n'

    if ! typed_discard_confirmation; then
        printf 'Discard cancelled.\n'
        return 0
    fi

    if [[ "$merge_in_progress" == true ]]; then
        printf 'Aborting active merge...\n'
        git_at_repo merge --abort || die 'merge abort failed; no reset or clean was performed'
    fi

    git_at_repo reset --hard HEAD
    git_at_repo clean -fd
    printf 'Discard complete. Ignored files and committed history were preserved.\n'
    git_at_repo status --short --branch
}

system_tui() {
    require_repo
    command -v lazygit >/dev/null 2>&1 || die 'LazyGit is not installed; install it or use the Git command line'
    ensure_repo_lazygit_config
    run_lazygit
}

system_menu() {
    require_repo
    local selected=''
    if has_whiptail_tty; then
        selected="$(whiptail --title 'end-4 system maintenance' \
            --menu 'Choose an operation:' 18 86 8 \
            review 'Compare fork and upstream without merging' \
            merge 'Fetch and review upstream changes' \
            update 'Preview and deploy committed configuration' \
            discard 'Abort merge and discard uncommitted Git state' \
            tui 'Open the repository in LazyGit' \
            quit 'Return without changing anything' \
            3>&1 1>&2 2>&3)" || return 0
    else
        if ! has_interactive_tty; then
            die 'the system menu requires an interactive terminal; use system merge/update/discard/tui directly'
        fi
        printf '\nend-4 system maintenance\n\n'
        printf '  1) review   Compare fork and upstream without merging\n'
        printf '  2) merge    Fetch and review upstream changes\n'
        printf '  3) update   Preview and deploy committed configuration\n'
        printf '  4) discard  Abort merge and discard uncommitted Git state\n'
        printf '  5) tui      Open the repository in LazyGit\n'
        printf '  6) quit     Return without changing anything\n'
        local choice
        read -r -p 'Choose an operation [6]: ' choice < /dev/tty
        case "${choice:-6}" in
            1) selected=review ;;
            2) selected=merge ;;
            3) selected=update ;;
            4) selected=discard ;;
            5) selected=tui ;;
            6) selected=quit ;;
            *) die 'invalid menu selection' ;;
        esac
    fi

    case "$selected" in
        review) review_upstream ;;
        merge) merge_upstream ;;
        update) system_update ;;
        discard) discard_local_state ;;
        tui) system_tui ;;
        quit|'') printf 'No changes made.\n' ;;
        *) die "unknown menu selection: $selected" ;;
    esac
}

command_name="${1:-menu}"
shift || true
if [[ "$command_name" == system ]]; then
    command_name="${1:-menu}"
    shift || true
fi

case "$command_name" in
    status|report)
        require_repo
        print_git_status
        ;;
    review|compare)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -h|--help) usage; exit 0 ;;
                *) die "unknown review option: $1" ;;
            esac
        done
        require_repo
        review_upstream
        ;;
    merge)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --yes) assume_yes=true; shift ;;
                -h|--help) usage; exit 0 ;;
                *) die "unknown merge option: $1" ;;
            esac
        done
        require_repo
        merge_upstream
        ;;
    update)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --device)
                    [[ $# -ge 2 ]] || die '--device requires a name'
                    normalize_device "$2"
                    shift 2
                    ;;
                --general) normalize_device general; shift ;;
                --prune) prune=true; shift ;;
                --dry-run) dry_run=true; shift ;;
                --yes) assume_yes=true; shift ;;
                -h|--help) usage; exit 0 ;;
                *) die "unknown update option: $1" ;;
            esac
        done
        require_repo
        system_update
        ;;
    discard)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --yes) assume_yes=true; shift ;;
                -h|--help) usage; exit 0 ;;
                *) die "unknown discard option: $1" ;;
            esac
        done
        discard_local_state
        ;;
    menu)
        system_menu
        ;;
    tui)
        system_tui
        ;;
    check)
        require_repo
        run_checks
        ;;
    bootstrap)
        require_repo
        (cd "$repo_root" && exec ./setup install "$@")
        ;;
    apply)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --device)
                    [[ $# -ge 2 ]] || die '--device requires a name'
                    normalize_device "$2"
                    shift 2
                    ;;
                --general) normalize_device general; shift ;;
                --dry-run) dry_run=true; shift ;;
                --force) force_apply=true; shift ;;
                --prune) prune=true; shift ;;
                -h|--help) usage; exit 0 ;;
                *) die "unknown apply option: $1" ;
            esac
        done
        require_repo
        apply_configs
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        die "unknown command: $command_name"
        ;;
esac
