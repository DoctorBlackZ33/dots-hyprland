#!/usr/bin/env bash
# handy-launch — global dictation hotkey handler (SUPER+CTRL+W on DarkArch).
#
# Toggle-with-auto-launch:
#   * Handy not running -> choose the backend, start Handy hidden in the tray,
#     start recording, and route the default input away from other apps.
#   * Handy already up -> stop recording, restore the previous default input,
#     and leave Handy resident in the tray.
#
# Model policy:
#   * enough free 2080 Ti VRAM -> Nemotron Streaming 3.5 on Vulkan/2080 Ti
#   * otherwise -> Nemotron Streaming 3.5 on CPU
#
# Audio policy:
#   Handy is pinned to the physical microphone. During recording, the launcher
#   switches the *default* input to a silent temporary PipeWire/Pulse sink
#   monitor. This keeps Handy's selected input alive while applications that
#   follow the default source receive silence. The previous default is restored
#   when the hotkey stops recording.
#
# Tuning: $XDG_CONFIG_HOME/handy-launch.conf (the DarkArch device overlay
# ships it under devices/DarkArch/.config/handy-launch.conf).

set -u

# --- Resolve the AppImage (version-agnostic) -------------------------------
HANDY_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/handy"
HANDY_BIN=""
for f in "$HANDY_DATA"/Handy_*.AppImage; do
  if [ -x "$f" ]; then HANDY_BIN="$f"; break; fi
done
if [ -z "$HANDY_BIN" ]; then
  echo "handy-launch: no Handy AppImage in $HANDY_DATA" >&2
  exit 1
fi

# --- Machine tuning (device overlay conf) ----------------------------------
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/handy-launch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${HANDY_GPU_NAME:=NVIDIA GeForce RTX 2080 Ti}"
: "${HANDY_VRAM_MB:=2048}"
: "${HANDY_MODEL_PREFERRED:=handy-computer/nemotron-3.5-asr-streaming-0.6b-gguf/nemotron-3.5-asr-streaming-0.6b-Q8_0.gguf}"
: "${HANDY_MICROPHONE:=Razer Seiren Elite}"
: "${HANDY_MUTE_SINK:=handy_muted_input}"
: "${HANDY_MUTE_SOURCE:=${HANDY_MUTE_SINK}.monitor}"

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/handy"
AUDIO_STATE="$LOG_DIR/input-route.state"
mkdir -p "$LOG_DIR"

# --- Input route helpers ----------------------------------------------------
restore_default_input() {
  [ -f "$AUDIO_STATE" ] || return 0

  old_source="$(sed -n '1p' "$AUDIO_STATE" 2>/dev/null || true)"
  module_id="$(sed -n '2p' "$AUDIO_STATE" 2>/dev/null || true)"
  if [ -n "$old_source" ]; then
    pactl set-default-source "$old_source" 2>/dev/null ||
      echo "handy-launch: could not restore default input $old_source" >&2
  fi
  case "$module_id" in
    ''|*[!0-9]*) ;;
    *) pactl unload-module "$module_id" >/dev/null 2>&1 || true ;;
  esac
  rm -f "$AUDIO_STATE"
}

mute_default_input() {
  [ -f "$AUDIO_STATE" ] && return 0
  command -v pactl >/dev/null 2>&1 || {
    echo "handy-launch: pactl unavailable; input route unchanged" >&2
    return 1
  }

  old_source="$(pactl get-default-source 2>/dev/null || true)"
  [ -n "$old_source" ] || {
    echo "handy-launch: no default input source to preserve" >&2
    return 1
  }

  module_id=""
  if ! pactl list short sinks 2>/dev/null |
    awk -v name="$HANDY_MUTE_SINK" '$2 == name { found=1 } END { exit !found }'
  then
    module_id="$(
      pactl load-module module-null-sink \
        "sink_name=$HANDY_MUTE_SINK" \
        "sink_properties=device.description=Handy-Muted-Input" 2>/dev/null || true
    )"
    case "$module_id" in
      ''|*[!0-9]*)
        echo "handy-launch: could not create silent input route" >&2
        return 1
        ;;
    esac
  fi

  if ! pactl set-default-source "$HANDY_MUTE_SOURCE" 2>/dev/null; then
    case "$module_id" in
      ''|*[!0-9]*) ;;
      *) pactl unload-module "$module_id" >/dev/null 2>&1 || true ;;
    esac
    echo "handy-launch: could not switch default input to $HANDY_MUTE_SOURCE" >&2
    return 1
  fi

  printf '%s\n%s\n' "$old_source" "$module_id" >"$AUDIO_STATE"
  echo "handy-launch: default input muted via $HANDY_MUTE_SOURCE" >&2
}

app_is_running() {
  pgrep -x handy >/dev/null 2>&1 ||
    pgrep -f 'Handy_.*\.AppImage' >/dev/null 2>&1
}

# A stale route can survive an app crash. Restore it before any new launch.
if ! app_is_running; then
  restore_default_input
fi

# --- Already running? Toggle and route input --------------------------------
if app_is_running; then
  "$HANDY_BIN" --toggle-transcription
  rc=$?
  if [ -f "$AUDIO_STATE" ]; then
    restore_default_input
  else
    # The user may have launched Handy manually; treat this toggle as start.
    mute_default_input || true
  fi
  exit "$rc"
fi

# --- 2080 Ti free-VRAM probe ------------------------------------------------
nvidia_free_mb=0
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia_free_mb="$(
    nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null |
      head -n1
  )" || nvidia_free_mb=0
  nvidia_free_mb="${nvidia_free_mb//[!0-9]/}"
  [ -n "$nvidia_free_mb" ] || nvidia_free_mb=0
fi

# --- Tier decision -----------------------------------------------------------
model="$HANDY_MODEL_PREFERRED"
accel=cpu
device_index=""
if [ "$nvidia_free_mb" -ge "$HANDY_VRAM_MB" ]; then
  candidate_index="$(
    "$HANDY_BIN" --list-devices 2>&1 |
      awk -v name="$HANDY_GPU_NAME" 'index($0, name) {
        sub(/^.*index=/, "")
        sub(/ .*/, "")
        print
        exit
      }'
  )"
  case "$candidate_index" in
    ''|*[!0-9]*) ;;
    *) accel=gpu; device_index="$candidate_index" ;;
  esac
fi

echo "handy-launch: tier=$([ "$accel" = gpu ] && echo "gpu:$device_index" || echo cpu) model=$model (nvidia free=${nvidia_free_mb}MiB)" >&2

# --- Write the tier and runtime behavior into Handy's settings store --------
STORE="${XDG_DATA_HOME:-$HOME/.local/share}/com.pais.handy/settings_store.json"
mkdir -p "$(dirname "$STORE")"
HANDY_STORE="$STORE" HANDY_MODEL="$model" HANDY_ACCEL="$accel" HANDY_DEVICE="$device_index" HANDY_MICROPHONE="$HANDY_MICROPHONE" python3 - <<'EOF'
import json
import os

path = os.environ["HANDY_STORE"]
try:
    with open(path) as fh:
        store = json.load(fh)
    if not isinstance(store, dict):
        store = {}
except Exception:
    store = {}

settings = store.get("settings")
if not isinstance(settings, dict):
    settings = {}
settings["settings_schema_version"] = 2
settings["onboarding_completed"] = True
settings["start_hidden"] = True
settings["show_tray_icon"] = True
settings["mute_while_recording"] = False
settings["selected_microphone"] = os.environ["HANDY_MICROPHONE"]
settings["selected_model"] = os.environ["HANDY_MODEL"]
settings["transcribe_accelerator"] = os.environ["HANDY_ACCEL"]
if os.environ.get("HANDY_DEVICE"):
    # Handy 0.9.5 stores the transcribe.cpp registry index as an integer.
    settings["transcribe_gpu_device"] = int(os.environ["HANDY_DEVICE"])
else:
    settings.pop("transcribe_gpu_device", None)
store["settings"] = settings

with open(path, "w") as fh:
    json.dump(store, fh, indent=2)
    fh.write("\n")
EOF

# --- Launch hidden, wait for the single-instance endpoint, start recording --
# The CLI flag is redundant with start_hidden but prevents a foreground flash.
pre_sockets="$(ls -1d /tmp/scoped_dir*/SingletonSocket 2>/dev/null | sort)"
setsid "$HANDY_BIN" --start-hidden >>"$LOG_DIR/app.log" 2>&1 &

for _ in $(seq 1 150); do
  cur_sockets="$(ls -1d /tmp/scoped_dir*/SingletonSocket 2>/dev/null | sort)"
  [ "$cur_sockets" != "$pre_sockets" ] && break
  sleep 0.2
done

"$HANDY_BIN" --toggle-transcription
rc=$?
if [ "$rc" -eq 0 ]; then
  mute_default_input || true
else
  restore_default_input
fi
exit "$rc"
