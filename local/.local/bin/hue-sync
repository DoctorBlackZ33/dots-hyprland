#!/bin/bash
# Hue screen-to-light sync launcher
# Usage: hue-sync start|stop|status|restart

PID_FILE="/tmp/hue-sync.pid"
SCRIPT="$HOME/.local/share/hue-sync/screen_to_hue.py"

case "$1" in
    start)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE")
            if kill -0 "$pid" 2>/dev/null; then
                echo "Already running (PID $pid)"
                exit 0
            fi
        fi

        # Start sync in background
        PYTHONUNBUFFERED=1 "$HOME/.local/src/lumux/venv/bin/python" "$SCRIPT" start &
        pid=$!
        echo $pid > "$PID_FILE"
        echo "Started hue-sync (PID $pid)"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE")
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid"
                echo "Stopped hue-sync (PID $pid)"
                rm -f "$PID_FILE"
            else
                echo "Not running (stale PID file)"
                rm -f "$PID_FILE"
            fi
        else
            echo "Not running"
        fi
        ;;
    status)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE")
            if kill -0 "$pid" 2>/dev/null; then
                echo "Running (PID $pid)"
            else
                echo "Not running (stale PID file)"
                rm -f "$PID_FILE"
            fi
        else
            echo "Not running"
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: hue-sync {start|stop|status|restart}"
        exit 1
        ;;
esac
